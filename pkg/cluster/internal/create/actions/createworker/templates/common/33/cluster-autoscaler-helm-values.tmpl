{{- $eks := and (eq $.KeosCluster.Spec.InfraProvider "aws") $.KeosCluster.Spec.ControlPlane.Managed }}
autoDiscovery:
  clusterName: {{ $.KeosCluster.Metadata.Name }}
{{- if not $eks }}
  labels:
  - namespace: cluster-{{ $.KeosCluster.Metadata.Name }}
  roles:
  - worker
{{- end }}
  tags:
  - k8s.io/cluster-autoscaler/enabled
  - k8s.io/cluster-autoscaler/{{ $.KeosCluster.Metadata.Name }}
{{- if $eks }}
awsRegion: {{ $.KeosCluster.Spec.Region }}
cloudProvider: aws
{{- else }}
cloudProvider: clusterapi
{{- end }}

# Upstream CA of the cluster's minor (the Stratio 1.35 build only matters for clusterapi MachinePools)
image:
  repository: {{ if $.Private }}{{ $.KeosRegUrl }}{{ if $.CentralECR }}/k8s{{ end }}{{ else }}registry.k8s.io{{ end }}/autoscaling/cluster-autoscaler
  tag: v1.33.6
replicaCount: 2
