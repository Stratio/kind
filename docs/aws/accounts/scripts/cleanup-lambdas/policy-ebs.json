{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:DescribeRegions", "ec2:DescribeInstances", "ec2:DescribeVolumes"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["ec2:DeleteVolume", "ec2:CreateTags", "ec2:DeleteTags"],
      "Resource": "arn:aws:ec2:*:ACCOUNT_ID:volume/*"
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:ACCOUNT_ID:log-group:/aws/lambda/deleteUnusedEBS:*"
    }
  ]
}
