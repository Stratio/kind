{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ec2:DescribeRegions", "eks:ListClusters", "eks:DescribeCluster", "iam:ListOpenIDConnectProviders"],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["iam:GetOpenIDConnectProvider", "iam:DeleteOpenIDConnectProvider"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:oidc-provider/*"
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:ACCOUNT_ID:log-group:/aws/lambda/deleteoldOIDC:*"
    }
  ]
}
